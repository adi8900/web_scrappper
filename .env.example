# Copy to .env. Use strong values and do not commit the real file.
MYSQL_ROOT_PASSWORD=CHANGE_ME_RANDOM_ROOT_PASSWORD
MYSQL_DATABASE=scraper
MYSQL_USER=user
MYSQL_PASSWORD=CHANGE_ME_RANDOM_DB_PASSWORD
JWT_SECRET_KEY=CHANGE_ME_GENERATE_A_RANDOM_STRING_LONGER_THAN_32_CHARACTERS
REDIS_PASSWORD=CHANGE_ME_RANDOM_REDIS_PASSWORD\n# For remote workers, bind to a trusted LAN IP and restrict with firewall.\nREDIS_BIND_IP=127.0.0.1

# Set the publicly reachable master address for browsing from other computers.
NEXT_PUBLIC_API_URL=http://localhost:8000
CORS_ORIGINS=http://localhost:3001
PRODUCT_COUNT=15
